# LeRobot cameras, bound by USB port (both C920 have no serial; both wrist cams share one serial).
# Moving a camera cable to another port swaps the name.
SUBSYSTEM=="video4linux", KERNELS=="1-2.2:1.0", ATTR{index}=="0", SYMLINK+="cam_front_left", MODE="0666"
SUBSYSTEM=="video4linux", KERNELS=="1-2.4:1.0", ATTR{index}=="0", SYMLINK+="cam_front_right", MODE="0666"
SUBSYSTEM=="video4linux", KERNELS=="1-2.3.4:1.0", ATTR{index}=="0", SYMLINK+="cam_wrist_left", MODE="0666"
SUBSYSTEM=="video4linux", KERNELS=="1-2.1.3:1.0", ATTR{index}=="0", SYMLINK+="cam_wrist_right", MODE="0666"
